# Password gate
DEMO_ACCESS_CODE=anden-demo

# AI provider
# Use "mock" for zero-cost deterministic demo behavior.
# Use "openai" only when OPENAI_API_KEY is set and MAX_DEMO_AI_COST_USD is capped.
AI_PROVIDER=mock
AI_MODEL=gpt-4.1-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
MAX_DEMO_AI_COST_USD=5

# OpenAI hosted mode
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional local Ollama mode
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional Supabase live mode, server-only preferred
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional read-only fallback. Do not use these when service-role variables are set.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
